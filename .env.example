# Copy to .env and fill in. NEVER commit .env. Values here are placeholders, not real secrets.

# --- PostgreSQL ------------------------------------------------------------------------------
POSTGRES_DB=netops
POSTGRES_USER=netops
# Required. Use a long random value (letters/digits; URL-encode any special characters).
POSTGRES_PASSWORD=

# --- Secrets ---------------------------------------------------------------------------------
# Required. Encrypts switch credentials at rest (Fernet key: 32 random bytes, url-safe base64).
# Generate with either of:
#   openssl rand -base64 32 | tr '+/' '-_'
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a secure backup: losing it makes stored switch passwords unrecoverable.
CREDENTIAL_ENCRYPTION_KEY=

# --- First administrator (optional) ------------------------------------------------------------
# Used only when the users table is empty. Remove the password after first start, or leave both
# empty and create the admin with: docker compose exec backend python -m app.cli create-user --role admin <name>
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# --- Web -------------------------------------------------------------------------------------
# Keep true in production (cookies only over HTTPS). false only for plain-HTTP lab use.
COOKIE_SECURE=true
SESSION_TTL_MINUTES=480
HTTP_PORT=8080
HTTPS_PORT=8443
# http.conf (plain HTTP / behind a TLS load balancer) or https.conf (certs in ./certs)
NGINX_SITE=http.conf

# --- SSH engine ------------------------------------------------------------------------------
# Maximum parallel SSH sessions (the old name MAX_CONCURRENT_SWITCH_CONNECTIONS is also accepted).
MAX_CONCURRENT_SSH=5
# Connect timeout in seconds (alias: SSH_CONNECT_TIMEOUT).
SSH_TIMEOUT=10
SSH_LOGIN_TIMEOUT=20
# Per-command timeout in seconds (alias: SSH_COMMAND_TIMEOUT).
COMMAND_TIMEOUT=15
# Hard limit for one SSH session; further commands are refused after it.
SSH_MAX_SESSION_SECONDS=300
SSH_CONNECT_RETRIES=1
SSH_SWITCH_BUDGET_SECONDS=120
# LAB ONLY. true disables host-key verification for switches without an enrolled key.
SSH_ALLOW_UNKNOWN_HOST_KEYS=false

# --- Safety ----------------------------------------------------------------------------------
# ENABLED | DISABLED. DISABLED forces the kill switch: every state-changing command is blocked,
# whatever is configured in the UI. Read-only operations continue.
NETWORK_COMMAND_EXECUTION=ENABLED
# true forces operation mode READ_ONLY: RESTART_PORT is blocked for everyone; MAC search and port
# queries work normally. RECOMMENDED for the initial production deployment.
READ_ONLY_MODE=true
# Consecutive SSH failures on previously healthy switches before SAFE MODE (circuit breaker).
CIRCUIT_BREAKER_THRESHOLD=5
# Initial value of the dry-run setting (changeable later by an admin in Settings).
DEFAULT_DRY_RUN=true

# --- Integrations (optional, read-only) ------------------------------------------------------
# NetBox REST API (GET only). Use a read-only API token.
NETBOX_URL=
NETBOX_TOKEN=
NETBOX_VERIFY_TLS=true
# Zabbix JSON-RPC API (apiinfo.version, host.get, problem.get only). Zabbix 6.4+ API token.
ZABBIX_URL=
ZABBIX_TOKEN=
ZABBIX_VERIFY_TLS=true
INTEGRATION_TIMEOUT=10

# --- Lab mode --------------------------------------------------------------------------------
ENABLE_SIMULATOR=false

# --- Logging ---------------------------------------------------------------------------------
LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text
